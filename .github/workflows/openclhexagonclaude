name: build-llama-cpp-snapdragon-dual

on:
  workflow_dispatch:
    inputs:
      llama_cpp_ref:
        description: "llama.cpp 分支/tag/commit"
        required: false
        default: "master"

jobs:
  build-android-dual-backend:
    runs-on: ubuntu-latest
    steps:
      - name: Clone official llama.cpp (unmodified)
        run: |
          git clone --depth 1 --branch "${{ github.event.inputs.llama_cpp_ref }}" \
            https://github.com/ggml-org/llama.cpp.git llama.cpp

      - name: Build inside official Snapdragon toolchain container
        run: |
          docker run --rm \
            -u $(id -u):$(id -g) \
            --platform linux/amd64 \
            --volume ${{ github.workspace }}/llama.cpp:/workspace \
            ghcr.io/snapdragon-toolchain/arm64-android:v0.3 \
            bash -c "
              cd /workspace &&
              cp docs/backend/hexagon/CMakeUserPresets.json . &&
              cmake --preset arm64-android-snapdragon-release -B build-snapdragon &&
              cmake --build build-snapdragon -j\$(nproc)
            "

      - name: Package artifacts
        run: |
          mkdir -p out
          cp -r llama.cpp/build-snapdragon/bin out/ 2>/dev/null || true
          find llama.cpp/build-snapdragon -name "*.so" -exec cp {} out/ \; 2>/dev/null || true

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: llama-cpp-snapdragon-dual-backend
          path: out/
